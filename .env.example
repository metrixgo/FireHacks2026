# Environment Variables for AI Exercise Route Planner
# Copy this file to .env and fill in your actual API keys

# Featherless AI API Key
# Get your key at: https://featherless.ai
# Used for: Extracting target distance from prompts and generating route summaries
FEATHERLESS_API_KEY=your_featherless_api_key_here

# OpenRouteService API Key
# Get your free key at: https://openrouteservice.org
# Used for: Generating walking/running routes
ORS_API_KEY=your_ors_api_key_here
